# Shared response-header policy imported by every public site block.
#
# Strict-Transport-Security lives here rather than in individual sites so that
# adding a site cannot silently omit it. `preload` is deliberately absent: it is
# a one-way submission to browser vendors and needs its own reviewed change.
(security_headers) {
	# RFC 7239 Forwarded and X-Forwarded-Port are not rewritten by Caddy
	# for untrusted clients. Drop them at ingress so downstream services can
	# only consume forwarding metadata generated by the trusted proxy chain.
	request_header -Forwarded
	request_header -X-Forwarded-Port
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
