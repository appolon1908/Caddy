# Repository-only Codestra observability UI routes. Native monitoring services
# are intentionally absent: the validator rejects any public Caddy route for them.

graf.codestra.media {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups
	request_header -X-Authenticated-Client
	request_header -X-Authenticated-Tenant
	request_header -X-Authenticated-Role
	request_header -X-Codestra-Gateway-Secret

	reverse_proxy {$CADDY_GRAFANA_UPSTREAM} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		flush_interval -1
		stream_timeout 5m
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/graf-codestra-media-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>X-Auth-Request-Access-Token delete
			request>headers>X-Access-Token delete
			request>headers>X-Id-Token delete
			request>headers>X-Refresh-Token delete
			request>headers>X-Vault-Token delete
			request>headers>X-Bao-Token delete
			request>uri query {
				delete access_token
				delete api-key
				delete api_key
				delete apikey
				delete client_secret
				delete code
				delete id_token
				delete oauth_token
				delete password
				delete rd
				delete refresh_token
				delete secret
				delete session_state
				delete state
				delete token
			}
			resp_headers>Authorization delete
			resp_headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
			resp_headers>X-Access-Token delete
			resp_headers>X-Auth-Request-Access-Token delete
			resp_headers>X-Id-Token delete
			resp_headers>X-Refresh-Token delete
		}
	}
}

