# Repository-only Codestra observability UI routes. Native monitoring services
# are intentionally absent: the validator rejects any public Caddy route for them.

graf.codestra.media {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups
	request_header -X-Authenticated-Client
	request_header -X-Authenticated-Tenant
	request_header -X-Authenticated-Role
	request_header -X-Codestra-Gateway-Secret

	reverse_proxy {$CADDY_GRAFANA_UPSTREAM} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		flush_interval -1
		stream_timeout 5m
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	import access_log graf-codestra-media
}

supe.codestra.media {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups
	request_header -X-Authenticated-Client
	request_header -X-Authenticated-Tenant
	request_header -X-Authenticated-Role
	request_header -X-Codestra-Gateway-Secret

	reverse_proxy {$CADDY_SUPERSET_UPSTREAM} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		flush_interval -1
		stream_timeout 5m
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}

	import access_log supe-codestra-media
}

bao.codestra.media {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	@openbao_allowed remote_ip {$CADDY_OPENBAO_ALLOWED_CIDRS}

	handle @openbao_allowed {
		request_body {
			max_size 2MB
		}

		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Email
		request_header -X-Auth-Request-Groups
		request_header -X-Authenticated-Client
		request_header -X-Authenticated-Tenant
		request_header -X-Authenticated-Role
		request_header -X-Codestra-Gateway-Secret

		reverse_proxy {$CADDY_OPENBAO_UPSTREAM} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			flush_interval -1
			stream_timeout 5m
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		respond "Forbidden" 403
	}

	import access_log bao-codestra-media
}
