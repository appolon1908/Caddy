# Community-compatible n8n editor edge.
#
# Caddy terminates public HTTPS and sends every editor request to oauth2-proxy.
# oauth2-proxy performs Keycloak OIDC authorization and then proxies to the
# private n8n editor. Caddy never routes this host directly to n8n.
{$CADDY_N8N_EDITOR_HOST} {
	@reserved_observability_host host aler.codestra.media allo.codestra.media blac.codestra.media cadv.codestra.media loki.codestra.media node.codestra.media otel.codestra.media pgex.codestra.media prom.codestra.media rdex.codestra.media temp.codestra.media
	respond @reserved_observability_host "Not Found" 404

	import security_headers
	import public_boundary
	encode zstd gzip

	# Keep the edge ceiling aligned with the n8n N8N_PAYLOAD_SIZE_MAX value.
	# The deployment renders the equivalent byte count into this variable.
	request_body {
		max_size {$CADDY_N8N_EDITOR_MAX_REQUEST_BODY}
	}

	route {
		# Only production webhook/form endpoints may bypass editor login. Test and
		# owner-bootstrap surfaces never cross the public edge.
		@never_public path /webhook-test* /form-test* /rest/owner/setup* /rest/owner/dismiss-banner*
		respond @never_public 404

		# Never trust identity headers supplied by the browser. oauth2-proxy must
		# derive fresh identity and role context from the Keycloak session.
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Email
		request_header -X-Auth-Request-Groups
		request_header -X-Forwarded-User
		request_header -X-Forwarded-Email
		request_header -X-Forwarded-Groups
		request_header -Authorization

		reverse_proxy {$CADDY_N8N_OAUTH2_PROXY_UPSTREAM} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output file /var/log/caddy/n8n-editor-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>uri query {
				delete apikey
				delete code
				delete state
				delete session_state
				delete api_key
				delete access_token
				delete refresh_token
				delete id_token
				delete client_secret
				delete password
				delete secret
				delete token
			}
			resp_headers>Set-Cookie delete
		}
	}
}
