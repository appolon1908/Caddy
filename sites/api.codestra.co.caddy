			path_regexp ^(/api/v1/automation/policy\-check|/api/v1/control/callbacks|/api/v1/integrations/n8n/results|/api/v1/odoo/events|/platform/v1/agent\-provisioning/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/disable|/platform/v1/agent\-provisioning/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/release\-extension|/platform/v1/agent\-provisioning/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/repair\-intents|/platform/v1/agent\-provisioning/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/sync|/platform/v1/agent\-provisioning/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/webrtc/revoke|/platform/v1/agent\-provisioning/adopt\-extension|/platform/v1/agent\-provisioning/requests|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/reactivate|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/reconcile|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/revoke|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/suspend|/platform/v1/agent\-provisioning/reserve\-extension|/platform/v1/agent\-provisioning/webrtc/tickets|/platform/v1/commands|/platform/v1/commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/cancel|/platform/v1/commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/replay|/platform/v1/commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/retry|/platform/v1/connectors/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/readback|/platform/v1/connectors/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/reconcile|/platform/v1/contacts|/platform/v1/contacts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/notes|/platform/v1/contacts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/tasks|/platform/v1/email/production/activate|/platform/v1/email/production/authorize|/platform/v1/email/production/kill\-switch|/platform/v1/email/production/revoke|/platform/v1/integrations/github/events|/platform/v1/operations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/cancel|/platform/v1/operations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/replay|/platform/v1/opportunities|/platform/v1/rehearsals/no\-effect|/platform/v1/replays/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/cancel|/platform/v1/runtime/observations|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/contract\-refresh|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/telemetry\-profile|/platform/v1/session/context/select|/platform/v1/sync/reconciliations|/platform/v1/tasks/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/complete|/platform/v1/telemetry/heartbeats|/platform/v1/tickets|/v2/automation/approvals|/v2/automation/commands|/v2/automation/dead\-letters/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/replay|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/complete|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/fail|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/heartbeat|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/steps|/v2/automation/jobs/claim|/v2/automation/jobs/reconcile)$
		}
