# Canonical shared API-edge source owned by appolon1908/Caddy.
# Historical reference: appolon1908/codestra-production-platform
# ref: release/production-activation
# path: operations/caddy/api.codestra.co.caddy
#
# Caddy terminates the public edge. Kong owns API authentication, authorization,
# rate/route policy and the handoff to Middleware. Transitional legacy/realtime
# upstreams remain explicit until their equivalent Kong routes are accepted.
api.codestra.co {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	route {
		@private_only path /metrics /metrics/* /internal /internal/*
		handle @private_only {
			respond 404
		}

		@pending_contract path /api/v1/events/telnexa /api/v1/n8n/acknowledgements /v1/observability/incidents /v1/observability/kpis /webhooks/sms/inbound/* /webhooks/vicidial/call-result/*
		handle @pending_contract {
			respond 404
		}

		# Middleware denied and private_only operations terminate here; they never reach Kong.
		@contract_denied_get {
			method GET
			path_regexp ^(/api/v1/integrations/odoo/campaign\-commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/v1/integrations/n8n/operations|/v1/integrations/n8n/operations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$
		}
		handle @contract_denied_get {
			respond 404
		}

		@contract_denied_post {
			method POST
			path_regexp ^(/api/v1/integration/automation\-results|/api/v1/integration/campaign\-actions|/api/v1/integration/campaigns/actual\-state|/api/v1/integrations/odoo/campaign\-actions|/api/v1/integrations/odoo/campaign\-commands|/api/v1/odoo/campaign\-actions|/v1/integrations/n8n/commands|/v1/integrations/n8n/operations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/cancel|/v1/integrations/n8n/operations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/reconcile)$
		}
		handle @contract_denied_post {
			respond 404
		}

		# BEGIN GENERATED MIDDLEWARE CONTRACT ROUTES
		# Generated from config/middleware-public-api-route-contract.v1.json.
		# Caddy selects exact method+path pairs; Kong owns authentication and policy.
		# Client identity headers are stripped here; auth/correlation/idempotency/trace pass through.
		@canonical_get {
			method GET
			path_regexp ^(/api/v1/callbacks|/api/v1/integrations/n8n/results/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/api/v1/integrations/odoo/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/api/v1/integrations/odoo/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/desired\-state|/platform/v1/activity|/platform/v1/activity/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/agent\-provisioning/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/readback|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/history|/platform/v1/agents/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/presence|/platform/v1/agents/presence|/platform/v1/calls|/platform/v1/calls/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/campaigns|/platform/v1/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/channels|/platform/v1/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/health|/platform/v1/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/members|/platform/v1/commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/history|/platform/v1/commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/result|/platform/v1/connectors|/platform/v1/connectors/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/connectors/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/capabilities|/platform/v1/connectors/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/health|/platform/v1/contacts|/platform/v1/contacts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/contacts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/notes|/platform/v1/contacts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/tasks|/platform/v1/dead\-letters|/platform/v1/dead\-letters/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/email/identities|/platform/v1/email/production/audit|/platform/v1/email/production/quotas|/platform/v1/email/production/readiness|/platform/v1/email/production/status|/platform/v1/hosts|/platform/v1/hosts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/kernel/describe|/platform/v1/me/presence|/platform/v1/operations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/operations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/recovery\-history|/platform/v1/operations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/timeline|/platform/v1/opportunities|/platform/v1/opportunities/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/queues|/platform/v1/queues/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/queues/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/calls|/platform/v1/queues/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/members|/platform/v1/queues/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/metrics|/platform/v1/rehearsals/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/repositories|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/coverage|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/dependencies|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/deployments|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/endpoints|/platform/v1/session/context|/platform/v1/sms/identities|/platform/v1/sync/reconciliations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/sync/status|/platform/v1/telephony/assignments|/platform/v1/tenants|/platform/v1/tenants/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/tenants/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/campaigns|/platform/v1/tenants/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/health|/platform/v1/tenants/authorized|/platform/v1/tickets|/platform/v1/tickets/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/users/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/users/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/campaigns|/platform/v1/users/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/entitlements|/v2/automation/approvals/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/v2/automation/capabilities/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/v2/automation/commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$
		}
		handle @canonical_get {
			vars edge_route_id edge.canonical.get
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
				header_up -X-Codestra-Contract-Operation
				header_up -X-Codestra-Expected-Azp
				header_up -X-Codestra-Required-Scope
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}

		@canonical_patch {
			method PATCH
			path_regexp ^(/platform/v1/contacts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/contacts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/notes/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/opportunities/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/tasks/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/tickets/[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$
