klyrow.com {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	route {
		@browser path / /login /signup /forgot-password /verify-email /reset-password /logged-out /app /app/* /admin /admin/* /auth /auth/* /terms /privacy
		redir @browser https://app.klyrow.com{uri} 302

		reverse_proxy {$CADDY_KLYROW_UPSTREAM} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/klyrow-com-access.log
		format filter {
			request>headers>Authorization delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>uri query {
				delete apikey
				delete api_key
				delete access_token
				delete refresh_token
				delete id_token
				delete client_secret
				delete password
				delete secret
				delete token
			}
			resp_headers>Set-Cookie delete
		}
	}
}

