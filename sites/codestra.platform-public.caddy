# Canonical Codestra customer, CRM, Klyrow and protected operator URLs.
# Upstreams are private/environment-supplied. No native backend port is a public
# authority by itself; Caddy is the TLS and request-boundary authority.

codestra.co {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	reverse_proxy {$CADDY_CODESTRA_WEB_UPSTREAM} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		transport http {
			dial_timeout 5s
			response_header_timeout 45s
		}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/codestra-co-access.log
		format filter {
			request>headers>Authorization delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>uri query {
				delete apikey
				delete api_key
				delete access_token
				delete refresh_token
				delete id_token
				delete client_secret
				delete password
				delete secret
				delete token
			}
			resp_headers>Set-Cookie delete
		}
	}
}

www.codestra.co {
	import security_headers
	import edge_observability
	import public_boundary

	route {
		redir https://codestra.co{uri} permanent
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/www-codestra-co-access.log
		format filter {
			request>headers>Authorization delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>uri query {
				delete apikey
				delete api_key
				delete access_token
				delete refresh_token
				delete id_token
				delete client_secret
				delete password
				delete secret
				delete token
			}
			resp_headers>Set-Cookie delete
		}
	}
}

crm.codestra.agency {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	route {
		@database_admin path /web/database /web/database/*
		respond @database_admin 403

		reverse_proxy {$CADDY_ODOO_CRM_UPSTREAM} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			transport http {
				dial_timeout 5s
				response_header_timeout 45s
			}
		}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/crm-codestra-agency-access.log
		format filter {
			request>headers>Authorization delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>uri query {
				delete apikey
				delete api_key
				delete access_token
				delete refresh_token
				delete id_token
				delete client_secret
				delete password
				delete secret
				delete token
			}
			resp_headers>Set-Cookie delete
		}
	}
}

