# Keycloak public identity host. Caddy terminates TLS only; Keycloak issues
# identity. Keycloak's runtime gzip cache is read-only in this deployment,
# so the upstream request asks for identity encoding.
auth.codestra.co {
	import security_headers
	import edge_observability
	import public_boundary

	handle {
		vars edge_route_id edge.keycloak
		reverse_proxy {$CADDY_KEYCLOAK_UPSTREAM} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up Accept-Encoding identity
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/auth-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>X-Auth-Request-Access-Token delete
			request>headers>X-Access-Token delete
			request>headers>X-Id-Token delete
			request>headers>X-Refresh-Token delete
			request>headers>X-Vault-Token delete
			request>headers>X-Bao-Token delete
			request>uri query {
				delete access_token
				delete api-key
				delete api_key
				delete apikey
				delete client_secret
				delete code
				delete id_token
				delete oauth_token
				delete password
				delete rd
				delete refresh_token
				delete secret
				delete session_state
				delete state
				delete token
			}
			resp_headers>Authorization delete
			resp_headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
			resp_headers>X-Access-Token delete
			resp_headers>X-Auth-Request-Access-Token delete
			resp_headers>X-Id-Token delete
			resp_headers>X-Refresh-Token delete
		}
	}
}
