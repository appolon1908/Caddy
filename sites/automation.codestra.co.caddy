# Canonical n8n editor edge source owned by appolon1908/Caddy.
# Historical reference: appolon1908-hue/codestra-production-platform
# ref: release/production-activation
# path: operations/caddy/api.codestra.co.caddy
#
# The n8n editor is a human administrative surface. n8n Community Edition has no
# enterprise SSO, so the reviewed community-compatible strategy is
# "gateway-oidc-and-native-auth": Kong performs the Keycloak authorization-code
# browser flow, and n8n's own native owner login remains enabled behind it.
#
# Caddy stays a transport boundary here exactly as it is for api.codestra.co. It
# does not authenticate, does not mint identity headers, and does not rewrite the
# Authorization header. Removing the Kong hop would leave the editor unprotected,
# so there is deliberately no direct upstream to n8n in this file.
automation.codestra.co {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	# The editor accepts workflow imports, so the body ceiling is lower than the
	# shared API edge rather than inherited from it.
	request_body {
		max_size 4MB
	}

	# Defence in depth beneath the gateway's OIDC flow. The editor is never
	# intended to be reachable from the public internet at large, so a source
	# range must be supplied explicitly by the deployment environment.
	@offnet not remote_ip {$CADDY_EDITOR_ADMIN_CIDRS}

	# Everything lives inside one route because route preserves the order written
	# here. A sibling handle would instead be ordered by Caddy's own directive
	# sort, which places route before handle -- the catch-all below would then
	# answer first and this gate would never run.
	route {
		handle @offnet {
			respond "Not Found" 404
		}

		# Every remaining path is handed to Kong, which owns the Keycloak browser
		# flow and session policy for this host.
		handle {
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
			}
		}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/automation-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			request>headers>Cookie delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>uri query {
				delete apikey
				delete code
				delete state
				delete api_key
				delete access_token
				delete refresh_token
				delete id_token
				delete client_secret
				delete password
				delete secret
				delete token
			}
			resp_headers>Set-Cookie delete
		}
	}
}
