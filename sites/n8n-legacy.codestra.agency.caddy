# Third n8n editor edge, retained by owner decision (2026-09-30) as a
# private-network-only legacy staff surface. Only private source addresses
# reach the editor; public clients get the health probe or 403. It must
# never be opened to a public audience or pointed at another gate.
n8n.codestra.agency {
	import security_headers
	import edge_observability
	import public_boundary

	request_body {
		max_size {$CADDY_N8N_EDITOR_MAX_REQUEST_BODY}
	}
	encode gzip

	@health path /healthz /healthz/readiness
	handle @health {
		vars edge_route_id edge.n8n_legacy.health
		reverse_proxy {$CADDY_N8N_UPSTREAM} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	@staff_private remote_ip private_ranges
	handle @staff_private {
		vars edge_route_id edge.n8n_legacy.staff
		reverse_proxy {$CADDY_N8N_UPSTREAM} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		respond "Staff identity network required" 403
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/n8n-codestra-agency-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>X-Auth-Request-Access-Token delete
			request>headers>X-Access-Token delete
			request>headers>X-Id-Token delete
			request>headers>X-Refresh-Token delete
			request>headers>X-Vault-Token delete
			request>headers>X-Bao-Token delete
			request>uri query {
				delete access_token
				delete api-key
				delete api_key
				delete apikey
				delete client_secret
				delete code
				delete id_token
				delete oauth_token
				delete password
				delete rd
				delete refresh_token
				delete secret
				delete session_state
				delete state
				delete token
			}
			resp_headers>Authorization delete
			resp_headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
			resp_headers>X-Access-Token delete
			resp_headers>X-Auth-Request-Access-Token delete
			resp_headers>X-Id-Token delete
			resp_headers>X-Refresh-Token delete
		}
	}
}

