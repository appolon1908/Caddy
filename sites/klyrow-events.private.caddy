# Private Klyrow delivery-event ingress. The application origin is loopback-only;
# this listener is the sole private-network entry point and requires mTLS. It
# does not import public_boundary because its only route lives under /internal,
# which that snippet denies on public hosts; the same identity headers are
# stripped here instead.
https://middleware-email-events.internal.codestra.agency:18080 {
	bind {$CADDY_PRIVATE_INGRESS_BIND}
	tls {$CADDY_KLYROW_PKI_DIR:/etc/caddy/private/klyrow-events}/tls-fullchain.crt {$CADDY_KLYROW_PKI_DIR:/etc/caddy/private/klyrow-events}/tls.key {
		client_auth {
			mode require_and_verify
			trust_pool file {$CADDY_KLYROW_PKI_DIR:/etc/caddy/private/klyrow-events}/klyrow-client.crt
		}
	}
	import security_headers
	import edge_observability

	request_body {
		max_size 256KB
	}

	route {
		request_header -X-User-ID
		request_header -X-Username
		request_header -X-Email
		request_header -X-Roles
		request_header -X-Scopes
		request_header -X-Authenticated-UserID
		request_header -X-Authenticated-User
		request_header -X-Authenticated-Client
		request_header -X-Authenticated-Subject
		request_header -X-Authenticated-Tenant
		request_header -X-Authenticated-Campaign
		request_header -X-Authenticated-Role
		request_header -X-Authenticated-Email
		request_header -X-Codestra-Tenant
		request_header -X-Codestra-Scopes
		request_header -X-Codestra-Gateway-Secret
		request_header -X-Internal-Service
		request_header -X-Admin
		request_header -X-Consumer-ID
		request_header -X-Consumer-Username
		request_header -X-Consumer-Custom-ID
		request_header -X-Credential-Identifier
		request_header -X-Anonymous-Consumer
		request_header -X-Codestra-Contract-Operation
		request_header -X-Codestra-Expected-Azp
		request_header -X-Codestra-Required-Scope
		request_header -X-Forwarded-For

		@klyrow_event {
			remote_ip {$CADDY_KLYROW_SOURCE_CIDRS}
			method POST
			path /internal/provider-events/klyrow
		}
		handle @klyrow_event {
			vars edge_route_id edge.klyrow_events
			reverse_proxy {$CADDY_KLYROW_EVENTS_UPSTREAM} {
				header_up X-Forwarded-Proto https
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}
		handle {
			respond "Forbidden" 403
		}
	}

	import access_log klyrow-events
}
