# Legacy hostname compatibility is route-bounded and cannot bypass Kong.
# Its Kong routes are generated from the canonical host's Kong-owned routes and
# the canonical pending-contract denials apply here too, so the legacy
# hostname never widens exposure. Kong sees the canonical host.
api.codestra.agency {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip
	header X-Codestra-Canonical-Host "api.codestra.co"

	request_body {
		max_size 10MB
	}

	route {
		@pending_contract path /api/v1/events/telnexa /api/v1/n8n/acknowledgements /v1/observability/incidents /v1/observability/kpis /webhooks/sms/inbound/* /webhooks/vicidial/call-result/*
		handle @pending_contract {
			respond 404
		}

		# BEGIN GENERATED LEGACY AGENCY KONG ROUTES
		# Generated from config/kong-owned-edge-routes.v1.json (legacyAgencyHost); Kong sees the canonical host.
		@kong_owned_08 {
			method GET
			path_regexp ^/api/v1/messages$
		}
		handle @kong_owned_08 {
			vars edge_route_id edge.legacy_agency.codestra-communication-canonical-read
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host api.codestra.co
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
				header_up -X-Codestra-Contract-Operation
				header_up -X-Codestra-Expected-Azp
				header_up -X-Codestra-Required-Scope
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}

		@kong_owned_09 {
			method POST
			path_regexp ^/api/v1/control/messages$
		}
		handle @kong_owned_09 {
			vars edge_route_id edge.legacy_agency.codestra-communication-canonical-write
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host api.codestra.co
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
				header_up -X-Codestra-Contract-Operation
				header_up -X-Codestra-Expected-Azp
				header_up -X-Codestra-Required-Scope
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}

		@kong_owned_10 {
			method POST
			path_regexp ^/api/v1/results/messages$
		}
		handle @kong_owned_10 {
			vars edge_route_id edge.legacy_agency.codestra-communication-canonical-write
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host api.codestra.co
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
				header_up -X-Codestra-Contract-Operation
				header_up -X-Codestra-Expected-Azp
				header_up -X-Codestra-Required-Scope
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}

		@kong_owned_11 {
			method GET POST PATCH OPTIONS
			path_regexp ^/v1/crm(/.*)?$
		}
		handle @kong_owned_11 {
			vars edge_route_id edge.legacy_agency.crm-route
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host api.codestra.co
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
				header_up -X-Codestra-Contract-Operation
				header_up -X-Codestra-Expected-Azp
				header_up -X-Codestra-Required-Scope
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}

		@kong_owned_12 {
			method GET POST
			path_regexp ^/v1/email(/.*)?$
		}
		handle @kong_owned_12 {
			vars edge_route_id edge.legacy_agency.email-route
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host api.codestra.co
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
				header_up -X-Codestra-Contract-Operation
				header_up -X-Codestra-Expected-Azp
				header_up -X-Codestra-Required-Scope
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}

		@kong_owned_13 {
			method GET POST
			path_regexp ^/v1/sms(/.*)?$
		}
		handle @kong_owned_13 {
			vars edge_route_id edge.legacy_agency.sms-route
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host api.codestra.co
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
				header_up -X-Codestra-Contract-Operation
				header_up -X-Codestra-Expected-Azp
				header_up -X-Codestra-Required-Scope
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}

		@kong_owned_14 {
			method POST
			path_regexp ^/v1/webhooks(/.*)?$
		}
		handle @kong_owned_14 {
			vars edge_route_id edge.legacy_agency.webhooks-route
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host api.codestra.co
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {remote_host}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
				header_up -X-Consumer-ID
				header_up -X-Consumer-Username
				header_up -X-Consumer-Custom-ID
				header_up -X-Credential-Identifier
				header_up -X-Anonymous-Consumer
				header_up -X-Codestra-Contract-Operation
				header_up -X-Codestra-Expected-Azp
				header_up -X-Codestra-Required-Scope
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}

		# END GENERATED LEGACY AGENCY KONG ROUTES

		@realtime path /ws/agent /api/v1/realtime/sessions /healthz /readyz /version
		handle @realtime {
			vars edge_route_id edge.legacy_agency.realtime
			reverse_proxy {$CADDY_REALTIME_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {scheme}
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Email
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-UserID
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Subject
				header_up -X-Authenticated-Tenant
				header_up -X-Authenticated-Campaign
				header_up -X-Authenticated-Role
				header_up -X-Authenticated-Email
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Scopes
				header_up -X-Codestra-User
				header_up -X-Codestra-Role
				header_up -X-Codestra-Gateway-Secret
				header_up -X-Internal-Service
				header_up -X-Admin
