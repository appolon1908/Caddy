      "route": "breero-production-api-route",
      "decision": "FORWARD_TO_KONG",
      "reason": "the Breero API reaches Kong; its health probe is read-only, so non-GET /health is denied at the edge",
      "probes": [
        {
          "host": "api.breero.com",
          "method": "GET",
          "path": "/health",
          "expect": "kong"
        },
        {
          "host": "api.breero.com",
          "method": "POST",
          "path": "/api/v1/orders",
          "expect": "kong"
        },
        {
          "host": "api.breero.com",
          "method": "POST",
          "path": "/health",
          "expect": 404
        }
      ]
    },
