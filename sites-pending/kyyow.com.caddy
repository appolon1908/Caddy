# Kyyow public edge. Caddy terminates TLS and routes only reviewed public hosts.
# Authentication and authorization remain with Keycloak and the owning API.
app.kyyow.com {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip
	request_header -X-Authenticated-Client
	request_header -X-Authenticated-Tenant
	request_header -X-Authenticated-Role
	reverse_proxy {$CADDY_KYYOW_APP_UPSTREAM} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https
	}
	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/app-kyyow-com-access.log
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>X-Auth-Request-Access-Token delete
			request>headers>X-Access-Token delete
			request>headers>X-Id-Token delete
			request>headers>X-Refresh-Token delete
			request>headers>X-Vault-Token delete
			request>headers>X-Bao-Token delete
			request>uri query {
				delete access_token
				delete api-key
				delete api_key
				delete apikey
				delete client_secret
				delete code
				delete id_token
				delete oauth_token
				delete password
				delete rd
				delete refresh_token
				delete secret
				delete session_state
				delete state
				delete token
			}
			resp_headers>Authorization delete
			resp_headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
			resp_headers>X-Access-Token delete
			resp_headers>X-Auth-Request-Access-Token delete
			resp_headers>X-Id-Token delete
			resp_headers>X-Refresh-Token delete
		}
	}
}

api.kyyow.com {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	request_header -X-Authenticated-Client
	request_header -X-Authenticated-Tenant
	request_header -X-Authenticated-Role
	reverse_proxy {$CADDY_KYYOW_API_UPSTREAM} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https
	}
	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/api-kyyow-com-access.log
		format filter {
