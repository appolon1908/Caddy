# Canonical shared API edge. Caddy terminates TLS; Kong owns authentication,
# authorization, rate limits, route policy, and the handoff to Middleware.
api.codestra.co {
	import security_headers
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	route {
		# The initial public canary is deliberately smaller than the API surface.
		# Fail closed at the terminating edge before a non-read method can reach
		# the compatibility health authority.
		@readonly_canary_denied {
			path /healthz /readyz /version
			not method GET HEAD
		}
		handle @readonly_canary_denied {
			header Allow "GET, HEAD"
			respond "Method Not Allowed" 405
		}

		@readonly_canary {
			method GET HEAD
			path /healthz /readyz /version
		}
		handle @readonly_canary {
			reverse_proxy {$CADDY_REALTIME_UPSTREAM} {
				import proxy_common
			}
		}

		# Mission Control read-only API is a separate registered backend.
		# Kong enforces staging OIDC; this edge never mints identity headers.
		@mission_dashboard {
			method GET
			path /platform/v1/dashboard/contract /platform/v1/dashboard/repositories /platform/v1/dashboard/repository /platform/v1/dashboard/sources /platform/v1/dashboard/agents /platform/v1/dashboard/tasks /platform/v1/dashboard/task /platform/v1/dashboard/local-work /platform/v1/dashboard/notifications
		}
		handle @mission_dashboard {
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				import proxy_common
				header_up -X-User-ID
				header_up -X-Username
				header_up -X-Roles
				header_up -X-Scopes
				header_up -X-Authenticated-User
				header_up -X-Authenticated-Client
				header_up -X-Authenticated-Tenant
				header_up -X-Codestra-Tenant
				header_up -X-Codestra-Gateway-Secret
			}
		}

		# Only route path families backed by reviewed Kong source. Broad
		# /api/v1/control matching is deliberately avoided so an unimplemented
		# control subtype cannot become reachable by accident.
		@kong path /api/v1/control/messages* /api/v1/control/campaigns* /api/v1/control/agents* /api/v1/control/memberships* /api/v1/control/adapters* /api/v1/messages* /api/v1/events* /api/v1/results* /api/v1/reconciliation* /api/v1/health* /v1/integrations/n8n* /v1/admin/system* /v1/crm* /v1/email* /v1/sms* /v1/webhooks* /v1/intake*
		handle @kong {
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				import proxy_common
			}
		}

		# Explicit, monitored compatibility only. There is no generic fallback.
		@realtime path /ws/agent /api/v1/realtime/sessions
		handle @realtime {
			reverse_proxy {$CADDY_REALTIME_UPSTREAM} {
				import proxy_common
			}
		}

		handle {
			respond "Not Found" 404
		}
	}

	log {
		output file /var/log/caddy/api-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		import sanitized_access_log
	}
}
