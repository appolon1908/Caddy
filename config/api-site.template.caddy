# Canonical shared API-edge source owned by ingtrader21-spec/Caddy.
# Historical reference: appolon1908-hue/codestra-production-platform
# ref: release/production-activation
# path: operations/caddy/api.codestra.co.caddy
#
# Caddy terminates the public edge. Kong owns API authentication, authorization,
# rate/route policy and the handoff to Middleware. Transitional legacy/realtime
# upstreams remain explicit until their equivalent Kong routes are accepted.
api.codestra.co {
	import security_headers
	import edge_observability
	import public_boundary
	encode zstd gzip

	request_body {
		max_size 10MB
	}

@@ROUTES@@

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/api-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>X-Auth-Request-Access-Token delete
			request>headers>X-Access-Token delete
			request>headers>X-Id-Token delete
			request>headers>X-Refresh-Token delete
			request>headers>X-Vault-Token delete
			request>headers>X-Bao-Token delete
			request>uri query {
				delete access_token
				delete api-key
				delete api_key
				delete apikey
				delete client_secret
				delete code
				delete id_token
				delete oauth_token
				delete password
				delete rd
				delete refresh_token
				delete secret
				delete session_state
				delete state
				delete token
			}
			resp_headers>Authorization delete
			resp_headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
			resp_headers>X-Access-Token delete
			resp_headers>X-Auth-Request-Access-Token delete
			resp_headers>X-Id-Token delete
			resp_headers>X-Refresh-Token delete
		}
	}
}
