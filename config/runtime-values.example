# Non-secret Caddy edge runtime contract.
# Supply these values through the deployment environment; do not commit live secrets.

# Kong data-plane listener. Kong repository source exercises the proxy data plane on 127.0.0.1:8000.
CADDY_KONG_UPSTREAM=127.0.0.1:8000

# Transitional realtime/health listener from the historical reference.
# Remove or move behind Kong only after an accepted Kong realtime contract exists.
CADDY_REALTIME_UPSTREAM=127.0.0.1:18102

# Administrative source ranges permitted to reach the n8n editor host before the
# gateway's Keycloak browser flow runs. Space-separated CIDRs. There is no safe
# default: leaving this unset must fail closed at deploy review, never widen.
CADDY_EDITOR_ADMIN_CIDRS=REPLACE_WITH_VERIFIED_ADMIN_CIDRS

# Community-compatible n8n editor host. The production/staging value is supplied
# outside Git after DNS, TLS, Keycloak client and oauth2-proxy checks pass.
CADDY_N8N_EDITOR_HOST=n8n-editor.invalid

# Private oauth2-proxy listener. oauth2-proxy owns Keycloak OIDC and its upstream
# is the private n8n editor; Caddy must never point this host directly at :5678.
CADDY_N8N_OAUTH2_PROXY_UPSTREAM=127.0.0.1:4180

# Exact byte ceiling for editor requests. Keep this equal to
# N8N_PAYLOAD_SIZE_MAX * 1048576 for the same deployment. n8n's documented
# default is 16 MiB, represented here as 16777216 bytes.
CADDY_N8N_EDITOR_MAX_REQUEST_BODY=16777216

# Repository-only observability route validation references. These loopback and
# TEST-NET values do not assert production listeners, DNS, or access ranges.
CADDY_GRAFANA_UPSTREAM=127.0.0.1:18003
CADDY_SUPERSET_UPSTREAM=127.0.0.1:18088
CADDY_OPENBAO_UPSTREAM=127.0.0.1:18200
CADDY_OPENBAO_ALLOWED_CIDRS=192.0.2.0/24 198.51.100.0/24

# Kyyow public edge validation references. Production values remain private,
# environment-supplied listeners and require a separate cutover approval.
CADDY_KYYOW_APP_UPSTREAM=127.0.0.1:18300
CADDY_KYYOW_API_UPSTREAM=127.0.0.1:18301
CADDY_KYYOW_SEARCH_UPSTREAM=127.0.0.1:18302
CADDY_KYYOW_DOCS_UPSTREAM=127.0.0.1:18303
CADDY_KYYOW_AUTH_UPSTREAM=127.0.0.1:18304
CADDY_KYYOW_STATUS_UPSTREAM=127.0.0.1:18305
