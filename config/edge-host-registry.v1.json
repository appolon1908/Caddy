{
  "schema": "codestra.caddy-edge-host-registry.v1",
  "rule": "Every site address Caddy serves is registered here and nothing else is served. Unknown hosts fail closed: no certificate for an unknown SNI, 404 on port 80.",
  "unknown_host": {
    "https": "TLS handshake refused (no certificate)",
    "http": 404
  },
