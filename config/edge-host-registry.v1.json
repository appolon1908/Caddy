      "owner": "appolon1908/Caddy",
      "route_class": "kong-api",
      "tls_profile": "public-acme",
      "upstreams": [
        "CADDY_KONG_UPSTREAM",
        "CADDY_REALTIME_UPSTREAM"
      ],
      "auth_boundary": "kong-jwt",
      "security_header_profile": "api",
      "request_size_profile": "api-standard",
      "logging_profile": "json-redacted",
      "public": true
    },
