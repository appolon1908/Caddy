{
  "schema": "codestra.caddy-kong-edge.v1",
  "principalRepository": "appolon1908/Caddy",
  "gatewayRepository": "appolon1908/Kong",
  "identityRepository": "appolon1908/Keycloak",
  "writeBoundaryRepository": "appolon1908/Middleware-",
  "referenceRepository": "appolon1908/codestra-production-platform",
  "canonicalHost": "api.codestra.co",
  "kongUpstreamEnvironmentVariable": "CADDY_KONG_UPSTREAM",
  "kongReferenceListener": "127.0.0.1:8000",
  "realtimeUpstreamEnvironmentVariable": "CADDY_REALTIME_UPSTREAM",
  "identityBoundary": {
    "caddyAuthenticatesUsersOrServices": false,
    "authorizationHeaderForwardedToKong": true,
    "caddyCreatesTrustedApplicationIdentityHeaders": false,
    "kongPerformsOidcJwtAndScopePolicy": true,
    "middlewareRevalidatesPrivilegedAuthorization": true
  },
  "transitionalPaths": [
    "/ws/agent",
    "/api/v1/realtime/sessions",
    "/healthz",
    "/readyz",
    "/version"
  ],
  "privateOnlyPaths": [
    "/metrics",
    "/metrics/*",
    "/internal",
    "/internal/*"
  ],
  "privateOnlyRule": "Private Middleware surfaces are answered 404 at the Caddy public edge before Kong or any legacy fallback: /metrics and /metrics/* are private monitoring only and /internal plus /internal/* are service-to-service only.",
  "migration": {
    "legacyFallbackTemporarilyAllowed": false,
    "fullKongRouteParityRequiredBeforeRemovingFallback": true,
    "runtimeInventoryRequiredBeforeCutover": true,
    "rollbackRehearsalRequiredBeforeCutover": true,
    "productionCutoverAuthorizedBySource": false
  },
  "editorHost": {
    "host": "automation.codestra.co",
    "purpose": "n8n Community Edition editor, human administrative surface",
    "adminCidrEnvironmentVariable": "CADDY_EDITOR_ADMIN_CIDRS",
    "gatewayEnforcesKeycloakBrowserFlow": true,
    "caddyAuthenticatesEditorSessions": false,
    "directUpstreamToN8nAllowed": false,
    "nativeN8nAuthRequiredBehindGateway": true
  },
  "mcrBoundary": {
    "mission": "MCR-K",
    "productionCutoverAuthorizedBySource": false,
    "kongOnly": true,
    "authorizationHeaderForwarded": true,
    "trustedIdentityHeadersCreatedByCaddy": false,
    "publicInternalAndMetricsForbidden": true,
    "kongRouteContract": "appolon1908/Kong:config/kong-mcr-routes.v1.json",
    "managedPaths": [
      "/platform/v1/campaign-engine",
      "/platform/v1/leads",
      "/platform/v1/campaigns",
      "/platform/v1/delivery-events",
      "/platform/v1/suppressions"
    ],
    "coveredByKongOwnedRoutes": [
      "mcr-plan",
      "mcr-execute",
      "mcr-status",
      "mcr-journey",
      "mcr-next-action",
      "mcr-eligible-leads",
      "mcr-delivery-events",
      "mcr-suppressions"
    ]
  },
  "middlewareEdgeContract": {
    "source": "appolon1908/Middleware-:deploy/public-api-route-contract.json",
    "sourceSha": "e873010e0b50e2659ecfc820d86868ffda3a89e5",
    "kongVendoredCopy": "Kong:config/middleware-public-api-route-contract.v1.json",
    "sha256": "c48c20d8bc71918699abb03cefe1e3c5075536a9d91d8aea8df4fc031891db21",
    "sharedEdgeOperations": 133,
    "deniedOperations": 10,
    "privateOnlyOperations": 2,
    "rule": "every shared_edge and denied path is kept away from the legacy fallback; private_only operations never appear at the public edge",
    "sourceNote": "MIDDLEWARE_V3_PROTECTED_MAIN"
  },
  "identityHeaders": {
    "preservedToKong": [
      "Authorization",
      "X-Correlation-ID",
      "Idempotency-Key",
      "traceparent",
      "tracestate"
    ],
    "deletedBeforeKong": [
      "X-User-ID",
      "X-Username",
      "X-Email",
      "X-Roles",
      "X-Scopes",
      "X-Authenticated-UserID",
      "X-Authenticated-User",
      "X-Authenticated-Client",
      "X-Authenticated-Subject",
      "X-Authenticated-Tenant",
      "X-Authenticated-Campaign",
      "X-Authenticated-Role",
      "X-Authenticated-Email",
      "X-Codestra-Tenant",
      "X-Codestra-Scopes",
      "X-Codestra-User",
      "X-Codestra-Role",
      "X-Codestra-Gateway-Secret",
      "X-Internal-Service",
      "X-Admin",
      "X-Consumer-ID",
      "X-Consumer-Username",
      "X-Consumer-Custom-ID",
      "X-Credential-Identifier",
      "X-Anonymous-Consumer",
      "X-Codestra-Contract-Operation",
      "X-Codestra-Expected-Azp",
      "X-Codestra-Required-Scope"
    ],
    "rule": "Caddy deletes client-asserted identity headers on the Kong handoff and never sets one; Kong mints trusted identity after verification"
  },
  "publicApiDirect": {
    "PUBLIC_API_DIRECT_TO_MIDDLEWARE": 0,
